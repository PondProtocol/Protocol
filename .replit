# Pond Protocol documentation site.
#
# The GitHub repo root is not the site root. The static site lives in site/,
# builds with `npm ci && npm run check`, and writes HTML into site/dist.
#
# Replit needs BOTH .replit and replit.nix or the workspace stays in
# recovery mode ("Nix environment is broken"). Node is the nodejs-20
# module; replit.nix is intentionally empty so a stale package attr
# cannot fail the env build.
#
# Git + publish (same buttons as the other Greenhead Replit apps):
#   Git pane → Pull / Push / Sync, then Publishing → Publish / Republish.
#   Do not change Deployment type, build, or run in the UI — those edits
#   rewrite this file locally and are what made Pull start a rebase.
#   pull.rebase is forced off on boot so Pull merges instead of rebasing.
#
# Publish as Autoscale with serve.mjs. That is how greenhead.io serves
# /.well-known/xrp-ledger.toml (a Node process, not Static). Replit Static
# omits .well-known/ (verified 2026-09-16: /.well-known/ and /.nojekyll 404,
# /_headers 200). After republish:
#   cd site && npm run verify:live -- pond.greenhead.io
# Leave the issuer on-ledger Domain unset until that check passes.
# Do not click Recover original configuration files.

modules = ["nodejs-20"]
run = "bash -c 'cd site && (test -d node_modules || npm ci) && npm run check && npm run serve'"
entrypoint = "site/scripts/serve.mjs"
hidden = ["site/node_modules", "site/dist", ".git", ".config", ".cache"]
language = "javascript"
onBoot = "git config pull.rebase false"

[nix]
channel = "stable-24_05"

[packager]
language = "nodejs"
ignoredPaths = [".git", "site/node_modules", "site/dist", ".config", ".cache"]

[packager.features]
guessImports = false
enabledForHosting = false

[gitHubImport]
requiredFiles = [".replit", "replit.nix"]

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 8080
externalPort = 80

[deployment]
deploymentTarget = "autoscale"
build = ["bash", "-c", "cd site && npm ci && npm run check"]
run = ["bash", "-c", "cd site && node scripts/serve.mjs"]
ignorePorts = false

# Static fallback only: the host strips .well-known/, so map the XLS-26 URL onto
# the non-dot twin the build writes into site/dist/well-known/. Production is
# Autoscale; these rules matter if someone republishes as Static by mistake.
[[deployment.rewrites]]
from = "/.well-known/xrp-ledger.toml"
to = "/well-known/xrp-ledger.toml"

[[deployment.rewrites]]
from = "/.well-known/*"
to = "/well-known/*"

# XLS-26: wallets fetch this path from the browser. Missing CORS is silent.
# Match both the canonical URL and the non-dot twin.
[[deployment.responseHeaders]]
path = "/.well-known/xrp-ledger.toml"
name = "Access-Control-Allow-Origin"
value = "*"

[[deployment.responseHeaders]]
path = "/.well-known/xrp-ledger.toml"
name = "Content-Type"
value = "text/plain; charset=utf-8"

[[deployment.responseHeaders]]
path = "/.well-known/xrp-ledger.toml"
name = "X-Content-Type-Options"
value = "nosniff"

[[deployment.responseHeaders]]
path = "/well-known/xrp-ledger.toml"
name = "Access-Control-Allow-Origin"
value = "*"

[[deployment.responseHeaders]]
path = "/well-known/xrp-ledger.toml"
name = "Content-Type"
value = "text/plain; charset=utf-8"

[[deployment.responseHeaders]]
path = "/well-known/xrp-ledger.toml"
name = "X-Content-Type-Options"
value = "nosniff"

[[deployment.responseHeaders]]
path = "/.well-known/*"
name = "Access-Control-Allow-Origin"
value = "*"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd site && (test -d node_modules || npm ci) && npm run check && PORT=5000 npm run serve"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"
