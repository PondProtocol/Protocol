# Pond Protocol documentation site.
#
# The GitHub repo root is not the site root. The static site lives in site/,
# builds with `npm ci && npm run check`, and writes HTML into site/dist.
#
# Replit Static Deployments omit dotfiles/dot-directories from the published
# tree. Verified 2026-09-16 on pond.greenhead.io: /.well-known/ and /.nojekyll
# 404 while /_headers and /robots.txt 200. Two mitigations:
#   1. Publish as Autoscale and serve with site/scripts/serve.mjs (serves
#      .well-known/ from disk).
#   2. A non-dot twin at /well-known/xrp-ledger.toml plus the rewrite below,
#      so a Static publish can still answer the XLS-26 URL.
#
# After republish: cd site && npm run verify:live -- pond.greenhead.io
# Leave the issuer on-ledger Domain unset until that check passes.

modules = ["nodejs-20"]
run = "bash -c 'cd site && (test -d node_modules || npm ci) && npm run check && npm run serve'"
entrypoint = "site/scripts/serve.mjs"
hidden = ["site/node_modules", "site/dist", ".git"]
language = "nodejs"

[nix]
channel = "stable-24_05"

[gitHubImport]
requiredFiles = [".replit"]

[[ports]]
localPort = 8080
externalPort = 80

[deployment]
deploymentTarget = "autoscale"
build = ["bash", "-c", "cd site && npm ci && npm run check"]
run = ["bash", "-c", "cd site && node scripts/serve.mjs"]
publicDir = "site/dist"
ignorePorts = false

# Static fallback: the host strips .well-known/, so map the XLS-26 URL onto
# the non-dot twin the build writes into site/dist/well-known/.
[[deployment.rewrites]]
from = "/.well-known/xrp-ledger.toml"
to = "/well-known/xrp-ledger.toml"

[[deployment.rewrites]]
from = "/.well-known/*"
to = "/well-known/*"

# XLS-26: wallets fetch this path from the browser. Missing CORS is silent.
# Match both the canonical URL and the non-dot twin.
[[deployment.responseHeaders]]
path = "/.well-known/xrp-ledger.toml"
name = "Access-Control-Allow-Origin"
value = "*"

[[deployment.responseHeaders]]
path = "/.well-known/xrp-ledger.toml"
name = "Content-Type"
value = "text/plain; charset=utf-8"

[[deployment.responseHeaders]]
path = "/.well-known/xrp-ledger.toml"
name = "X-Content-Type-Options"
value = "nosniff"

[[deployment.responseHeaders]]
path = "/well-known/xrp-ledger.toml"
name = "Access-Control-Allow-Origin"
value = "*"

[[deployment.responseHeaders]]
path = "/well-known/xrp-ledger.toml"
name = "Content-Type"
value = "text/plain; charset=utf-8"

[[deployment.responseHeaders]]
path = "/well-known/xrp-ledger.toml"
name = "X-Content-Type-Options"
value = "nosniff"

[[deployment.responseHeaders]]
path = "/.well-known/*"
name = "Access-Control-Allow-Origin"
value = "*"
